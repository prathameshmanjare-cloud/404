# ---------------------------------------------------------------------------
# Secrets: never commit. Only the blank templates (.env.example) are tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---------------------------------------------------------------------------
# Python (backend)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/

# ---------------------------------------------------------------------------
# Node / Vite (frontend)
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Runtime output written by the app (recreated on every run)
# ---------------------------------------------------------------------------
*.log
backend/logs/
backend/data/
backend/evals/feedback.jsonl
# Recorded model responses for the golden-set gate: regenerate locally with
#   python -m evals.run_gate --record
backend/evals/cassettes/*
!backend/evals/cassettes/.gitkeep

# ---------------------------------------------------------------------------
# OS and editor files
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Local AI-assistant / tool settings (personal, machine-specific)
# ---------------------------------------------------------------------------
.claude/
